<?xml version="1.0"?>
<robot name="pioneer">

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://pioneer/meshes/chassis.dae"/>
      </geometry>
    </visual>
  </link>

 <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/> <!-- Увеличен радиус и уменьшен длину для более реалистичного вида -->
      </geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.1 0.1585 -0.05" rpy="1.5708 0 0"/> <!-- Смещение влево (y=0.2) и назад (x=-0.1) -->
    <axis xyz="0 0 1"/> <!-- Вращение вокруг вертикальной оси Z -->
  </joint>

</robot>